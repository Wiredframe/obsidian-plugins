{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": false,
		"isolatedModules": true,
		"strictNullChecks": true,
		"strict": true,
		"lib": ["DOM", "ES5", "ES6", "ES7", "ES2018"]
	},
	"include": ["src/**/*.ts"]
}
